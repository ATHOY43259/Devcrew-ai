# Copy this file to .env and fill in your key:  cp .env.example .env

# Which LLM provider call_llm() uses: "openai" or "gemini".
# Gemini (aistudio.google.com/apikey) has a free tier with no billing setup
# required — a good default if you don't want to add a card for OpenAI.
LLM_PROVIDER=openai

# --- OpenAI (used when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Gemini (used when LLM_PROVIDER=gemini) ---
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.0-flash

# 1 = run the whole pipeline with canned outputs (no API key needed, zero cost).
# Use this for UI development and as a fallback during the live demo.
MOCK_MODE=1

# Max Developer rework rounds triggered by Reviewer/Tester feedback
MAX_REVISIONS=2

# USD prices per 1M tokens for cost estimation — update to match whichever
# provider/model you're actually using (defaults below are OpenAI gpt-4o-mini
# prices; Gemini's free tier is $0 up to its rate limits).
PRICE_PER_1M_INPUT=0.15
PRICE_PER_1M_OUTPUT=0.60
